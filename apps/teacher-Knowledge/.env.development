# apps/teacher-knowledge/.env.development
# 开发环境配置

# API 基础路径
VITE_API_BASE_URL=/api

# WebSocket 服务地址（协作编辑）
VITE_WS_URL=ws://localhost:1234

# 应用标题
VITE_APP_TITLE=EducationOS · 教师知识库

# 应用环境
VITE_APP_ENV=development

# 是否启用调试模式
VITE_DEBUG=true

# 代理目标服务器
VITE_PROXY_TARGET=http://localhost:8000

# 日志级别
VITE_LOG_LEVEL=debug